# FlowMask 服务端环境变量示例
#
# 用法（PowerShell）：
#   Copy-Item .env.example .env      # 然后按需改值
#   .\scripts\start_local.ps1        # 一键启动脚本会读取 .env
#
# 说明：所有变量都以 FLOWMASK_ 前缀；未设置的项使用代码里的默认值（见 app/core/config.py）。
# 只需为本机演示时，一般改 ENABLE_L2 / ENABLE_L3 / ENABLE_NER 三行即可。

# ---------- 基础 ----------
# 数据目录（SQLite、上传临时文件、实时旁路抓包都在这里；默认 server/data）
FLOWMASK_DATA_DIR=
# SQLite 路径（默认 <DATA_DIR>/flowmask.db）
FLOWMASK_DB_PATH=
# HTTP 服务监听（默认 127.0.0.1:8090；对外提供服务时改 0.0.0.0 并务必设置 API_TOKEN）
FLOWMASK_HOST=127.0.0.1
FLOWMASK_PORT=8090
# Bearer Token：留空表示不鉴权（仅本机演示可留空）
FLOWMASK_API_TOKEN=
# 审计哈希链签名密钥（HMAC-SHA256）；生产环境应从密钥管理注入，不要用示例值
FLOWMASK_AUDIT_SECRET=flowmask-demo-secret

# ---------- L2 语义模型（ONNX int8，默认关闭） ----------
FLOWMASK_ENABLE_L2=0
FLOWMASK_L2_ENDPOINT=http://127.0.0.1:8091/v1/classify
FLOWMASK_L2_TIMEOUT_S=0.5
# 服务端（l2_service）自己的配置
FLOWMASK_L2_MODE=onnx
FLOWMASK_L2_MODEL_DIR=
FLOWMASK_L2_PORT=8091

# ---------- L3 大模型复核（指令裁判，默认关闭） ----------
FLOWMASK_ENABLE_L3=0
FLOWMASK_L3_MODE=http
FLOWMASK_L3_ENDPOINT=http://127.0.0.1:8092/v1/judge
FLOWMASK_L3_MODEL=qwen2.5-1.5b-instruct
FLOWMASK_L3_TIMEOUT_S=5.0
# L3 升级上限：默认 L2（保守口径，实测把 UnSafe 也封顶后准确率最高）
FLOWMASK_L3_MAX_TARGET=L2
# 是否采信模型返回的 level 建议 / 是否按 PII 类别抬升（默认都关）
FLOWMASK_L3_TRUST_LEVEL_HINT=0
FLOWMASK_L3_CATEGORY_RAISE=0
# 服务端（l3_service）自己的配置
FLOWMASK_L3_MODEL_DIR=
FLOWMASK_L3_DEVICE=cpu
FLOWMASK_L3_DTYPE=auto
FLOWMASK_L3_PORT=8092

# ---------- L1.5 自由文本 NER（人名/地址，默认关闭） ----------
FLOWMASK_ENABLE_NER=0
# 设为 1 关闭 base64 / 百分号编码的载荷解码复核（默认开启）
FLOWMASK_DISABLE_DECODE=0
FLOWMASK_NER_BACKEND=token
FLOWMASK_NER_MODEL_DIR=
FLOWMASK_NER_DEVICE=cpu

# ---------- 其它 ----------
FLOWMASK_MAX_UPLOAD_MB=20
FLOWMASK_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8080
